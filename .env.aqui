# Plantilla sin secretos. El archivo .env real está excluido de Git.
# Configure una clave aleatoria propia de al menos 50 caracteres.
# No reutilice la clave local en otros entornos.
DJANGO_SECRET_KEY=

# Base de datos: use mysql para WampServer o sqlite para el archivo local.
DB_ENGINE=sqlite
MYSQL_DATABASE=municipalidad
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Gmail: use una contraseña de aplicación, no la contraseña de su cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
