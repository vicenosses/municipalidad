# Plantilla sin secretos. El archivo .env real está excluido de Git.
# Configure una clave aleatoria propia de al menos 50 caracteres.
# No reutilice la clave local en otros entornos.
DJANGO_SECRET_KEY=

# Gmail: use una contraseña de aplicación, no la contraseña de su cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
